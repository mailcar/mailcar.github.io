---
import { formatDate } from '../../features/core/date';
import { getCategory, getCategoryPath, getTag, getTagPath } from '../../features/core/taxonomy';

interface Props {
  date: Date;
  categories: string[];
  tags: string[];
  compact?: boolean;
  showTags?: boolean;
  readingStats?: {
    words: number;
    minutes: number;
  };
  showViews?: boolean;
}

const { date, categories, tags, compact = false, showTags = true, readingStats, showViews = false } = Astro.props;
const visibleCategories = compact ? categories.slice(0, 1) : categories;
const visibleTags = showTags ? tags.slice(0, compact ? 3 : tags.length) : [];
---

<div class:list={['post-meta', { compact }]}>
  <span class="meta-primary-pair">
    <span class="meta-date-segment">
      <time datetime={date.toISOString()} data-pagefind-ignore>
        <svg class="meta-date-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 2v4M16 2v4" />
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M3 10h18" />
        </svg>
        {formatDate(date)}
      </time>
      {!compact && <span class="meta-separator" aria-hidden="true">·</span>}
    </span>
    <span class="meta-categories" data-pagefind-ignore>
      <svg class="meta-category-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" />
        <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" />
        <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
      </svg>
      {visibleCategories.map((categorySlug, index) => {
        const category = getCategory(categorySlug);
        return (
          <>
            {index > 0 && <span class="meta-category-separator" aria-hidden="true">、</span>}
            <a class="meta-link category" href={getCategoryPath(category.slug)}>{category.name}</a>
          </>
        );
      })}
      {!compact && readingStats && <span class="meta-separator" aria-hidden="true">·</span>}
    </span>
  </span>
  {readingStats && (
    <span class="meta-secondary-pair" data-pagefind-ignore>
      <span class="reading-stats">
        <svg class="meta-time-icon" viewBox="0 0 18 18" aria-hidden="true">
          <circle cx="9" cy="9" r="6" />
          <path d="M9 5.7v3.6l2.4 1.4" />
        </svg>
        <span>约 {readingStats.minutes} 分钟</span>
        {showViews && <span class="meta-separator" aria-hidden="true">·</span>}
      </span>
      {showViews && (
        <span class="post-views" aria-label="浏览量">
          <svg class="meta-views-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 4.1 12 6M5.1 8l-2.9-.8M6 12l-1.9 2M7.2 2.2 8 5.1" />
            <path d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.74l-1.04 4.35a.5.5 0 0 1-.95.074z" />
          </svg>
          <span id="twikoo_visitors">0</span>
        </span>
      )}
    </span>
  )}
  {visibleTags.length > 0 && (
    <span class="meta-tags">
      {visibleTags.map((tagSlug) => {
        const tag = getTag(tagSlug);
        return (
          <a class="meta-link tag" href={getTagPath(tag.slug)}>
            <svg class="meta-tag-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13.172 2a2 2 0 0 1 1.414.586l6.71 6.71a2.4 2.4 0 0 1 0 3.408l-4.592 4.592a2.4 2.4 0 0 1-3.408 0l-6.71-6.71A2 2 0 0 1 6 9.172V3a1 1 0 0 1 1-1z" />
              <path d="M2 7v6.172a2 2 0 0 0 .586 1.414l6.71 6.71a2.4 2.4 0 0 0 3.191.193" />
              <circle cx="10.5" cy="6.5" r=".5" fill="currentColor" />
            </svg>
            {tag.name}
          </a>
        );
      })}
    </span>
  )}
</div>
