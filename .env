# 复制一份命名为「.env」用作用户配置信息
# 优先级：系统/部署环境变量 > 根目录 .env > 代码默认值

# 站点信息
BLOG_TITLE="邮葫芦"
BLOG_SUBTITLE="邮箱┆主机┆域名┆媒体"
BLOG_LOGO="/mailer.png"
BLOG_LOGO_DARK="/mailer.png"

# SEO 信息
SEO_DESCRIPTION="邮箱┆主机┆域名┆媒体"
SEO_KEYWORDS="邮箱, 主机, 域名, 媒体"

# 是否显示 LOGO 旁站点标题，默认关闭；设置为 true 开启。
BLOG_SHOW_TITLE="true"

# URL 影响 sitemap、RSS、robots 的生成
BLOG_URL="https://blog.mans.cc"

# 主题设置
THEME_COLOR="#2D96E4"

# 博主信息「首页卡片」
BLOG_AUTHOR="Mailer"
BLOG_AVATAR="/mailer.png"
BLOG_BIO="汪小白的邮葫芦......"

# 是否将博主头像裁成圆形，默认（无变量、空值时候）开启；设置为 false 关闭。
BLOG_AVATAR_CIRCLE="true"

# 备案信息
# BEIAN="粤ICP备1234567890号"
# BEIAN_URL="http://beian.miit.gov.cn/"

# 评论系统（Twikoo）
# 留空表示不启用；启用时填写你的 Twikoo 服务地址，例如 https://twikoo.example.com
# TWIKOO_ENV_ID=""

# Twikoo js CDN（默认 npmmirror），一般不用改，若缓慢、失效自行更换
TWIKOO_JS_URL="https://registry.npmmirror.com/twikoo/1.7.15/files/dist/twikoo.min.js"

# 国内加速推荐
# https://registry.npmmirror.com/twikoo/1.7.15/files/dist/twikoo.min.js
# https://s4.zstatic.net/npm/twikoo@1.7.15/dist/twikoo.min.js

# jsdelivr（全球加速）
# https://cdn.jsdelivr.net/npm/twikoo@1.7.15/dist/twikoo.min.js
